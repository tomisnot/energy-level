{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // ⭐ 必须开：`@mecha/dsh-panel` 经 **junction** 装进来，TypeScript 默认按资产的
    // **真实路径**去找它的依赖 ⇒ 会按 mecha 仓那份去找（TS2307，连带 TS7006）。
    // 开了之后按 node_modules 里的链接路径解析。
    // ⚠ **2026-10-10**：原先这条注释举例的是装在本仓的 `@modelcontextprotocol/sdk`
    // —— 那个依赖随**自愈 MCP 桥**一起删了；这一项仍然要留（资产本体就在 junction 后面）。
    "preserveSymlinks": true,
    "lib": ["es2023", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    // 2026-09-25 曾因共享资产报 TS2345 而**临时**关闭；2026-09-26 **已恢复**。
    // 依据：上游已修（`path.split('?')[0] ?? ''` 等），并在**消费者这一层**实测
    // `--strict --noUncheckedIndexedAccess` 0 错误（mecha/dsh-panel @ f516a99）；其 README
    // 把「严格 tsconfig 下必须能过」写成**硬约束** ⇒ 项目不许为资产放松类型严格度。
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "lib/types",
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
