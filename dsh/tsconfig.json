{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    // ⚠ 暂时关闭（2026-09-25，共享资产迁移段 B 被迫）：`src/dsh-panel/*` 是 mecha
    // 共享资产的**逐字副本**（不许就地改），其 `monitor-client.ts:44` 的
    // `path.split('?')[0]` 在本旗标下报 TS2345（可能是 undefined）。
    // ⚠ `exclude` 不解决：TypeScript 仍会检查**被 import 到**的文件（client 半必须
    //    import 它），所以"排除"对可达导入无效——实测过。
    // 上游把它写成 `?? ''` 后：重新复制 + 更新 fingerprint，然后**恢复 true**。
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "lib/types",
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "types/**/*.d.ts"],
  // ⚠ src/dsh-panel 是 mecha 共享资产（mecha/dsh-panel @ 58e2f8a）的**逐字副本**，
  // 按资产 README 的复制约定**不许就地修改**。它的上游 tsconfig 没有本仓这条
  // noUncheckedIndexedAccess，故在它的严格度下报 TS2345（monitor-client.ts:44
  // split('?')[0] 可能是 undefined）。⇒ 项目侧**排除**它、不改资产：
  // 内容由 checks/dsh_panel_asset_selfcheck.py 的行尾归一指纹钉死，行为由
  // 随它一起复制的共享单测真跑（skipped 必须为 0）覆盖。
  // 若上游将来把那一行写成 `?? ''`，重新复制 + 更新指纹后即可撤掉本 exclude。
  "exclude": ["src/dsh-panel"]
}
