{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    // 2026-09-25 曾因共享资产报 TS2345 而**临时**关闭；2026-09-26 **已恢复**。
    // 依据：上游已修（`path.split('?')[0] ?? ''` 等），并在**消费者这一层**实测
    // `--strict --noUncheckedIndexedAccess` 0 错误（mecha/dsh-panel @ f516a99）；其 README
    // 把「严格 tsconfig 下必须能过」写成**硬约束** ⇒ 项目不许为资产放松类型严格度。
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "lib/types",
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "types/**/*.d.ts"]
}
