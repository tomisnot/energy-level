# Python / numba 编译缓存（自动再生，不入库）
*.pyc
*.pyo
*.nbc
*.nbi
__pycache__/

# 大数据 / 运行时产物（本机产物，不入库）
.arcdata/
save_state/
# runtime/ 整目录排除：sweeps（扫描产物）/ _journal（旧 AI 管线日志）/ check_profile.csv
# （scripts/check_profile.py 的诊断输出）。本机运行产物一律不入库：上面的 save_state/ 同样排除
# （存档归本地数据，历史上曾短暂入库，现已改回"只在磁盘侧"）。
runtime/
.mecha/
.mecha-v2/
scripts/tmp/

# MCP 写通道端口发现文件（权威进程写、dsh 插件 attach 用）
.mcp-port
# 只读监控端点的端口发现文件（权威进程写；dsh 插件 host 半经同源路由转给面板）
.monitor-port
# 看门人（launcher.py）的进程交接文件：切换意图 / 当前模式（运行时状态，不入库）

# 周边项目（不进主干）/ 各工具运行时状态
.dsh-vision-toolkit/
microwave_pulse/
.agent-teams/
.workbuddy/
.dsh/

# UI 设计检查的临时产物（可由 ui_design/*.py 重生成）
ui_design/screenshots/

# 研究配图的渲染产物（由 scripts/research/*.py 的 savefig 重生成）
# scripts/research/ 只入库 .py，不入库图片；如需归档某版本配图用 `git add -f`
scripts/research/figs_photon/

# 迁移 staging（Re0重构/）——已覆盖进父仓主干（commit 25ff146），此目录冗余、可手动删；
# 忽略它防 `git add -A` 误纳其 dsh/node_modules。删除目录后可移除此行。
Re0重构/
.human-token

# 统一启动器的运行期产物（pid / 日志）：每台机器各自生成，不入库。
# ⚠ 由框架 `mecha/launch.py` 写在「启动时的 cwd」下；含本机 pid。
_mecha_runtime/

# 控制端点的端口文件（运行时由软件写在自己的数据根/仓根里；⚠ 框架会清陈旧的，但运行期它就在那儿）
.control-port
